{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slug",
        "displayName"
      ],
      "additionalProperties": false
    },
    "course": {
      "type": "object",
      "properties": {
        "levelLabel": {
          "type": "string",
          "minLength": 1
        },
        "levelOrder": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "overviewSummary": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "learningObjectives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "estimatedTotalMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "languageCode": {
          "default": "vi",
          "type": "string",
          "minLength": 2
        }
      },
      "required": [
        "levelLabel",
        "levelOrder",
        "title"
      ],
      "additionalProperties": false
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapterOrder": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "lessons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lessonOrder": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "learningObjective": {
                  "type": "string",
                  "minLength": 1
                },
                "keyPoints": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "estimatedMinutes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "lessonOrder",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "chapterOrder",
          "title",
          "lessons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "category",
    "course",
    "chapters"
  ],
  "additionalProperties": false
}
