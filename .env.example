# Copy to .env and fill in. Never commit .env.
# No ?schema=public: Prisma defaults to the public schema, and omitting it keeps
# this URL directly usable by psql and other libpq tools.
DATABASE_URL="postgresql://knowledge_explorer:knowledge_explorer@localhost:5432/knowledge_explorer"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Host port 6380 avoids a collision with a native redis-server on 6379.
REDIS_URL="redis://localhost:6380"
API_PORT="3001"
# Where the browser reaches apps/api. Must match the API's CORS origin.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Object storage (P3) ---
# MinIO under Docker Compose; any S3-compatible store in production.
# Host port 9010 avoids a collision with a native php-fpm on 9000.
S3_ENDPOINT="http://localhost:9010"
# What presigned URLs are SIGNED against, which is not always what the API and
# worker talk to. An S3 signature covers the host, so a URL signed for an
# internal hostname fails in a browser with an opaque SignatureDoesNotMatch.
# These two hold the same value locally only because the API and worker run on
# the host rather than inside Compose; in production they differ. Do not merge
# them into one variable.
S3_PUBLIC_ENDPOINT="http://localhost:9010"
S3_REGION="us-east-1"
S3_BUCKET="knowledge-explorer-media"
S3_ACCESS_KEY_ID="knowledge_explorer"
S3_SECRET_ACCESS_KEY="knowledge_explorer"

# --- Image generation (P3) ---
# Anything but `openai` — including unset — selects the deterministic fake
# provider, which is what CI runs and what makes the suites byte-stable.
# `openai` with no OPENAI_API_KEY fails at startup rather than downgrading.
IMAGE_PROVIDER="fake"
OPENAI_API_KEY=""

# The §11 LlmProvider, selected the same way and for the same reason (P4).
# Anything but `anthropic` — including unset — selects the deterministic fake.
# `anthropic` with no ANTHROPIC_API_KEY fails at startup rather than quietly
# narrating with the fake, which reads as plausible prose and is noticed by
# nobody until a learner hears a lesson that says nothing.
LLM_PROVIDER="fake"
ANTHROPIC_API_KEY=""
# Overrides the model pinned in anthropic-llm.provider.ts (§6.3: claude-sonnet-5).
# Re-verify the identifier and its pricing against current documentation before
# changing it.
ANTHROPIC_MODEL=""

# --- Text to speech (P5) ---
# §11's TextToSpeechProvider, selected the same way as the two above.
# Anything but `openai` — including unset — selects the deterministic fake,
# which emits real MP3 tones so the merge and its offsets are genuinely
# exercised without a paid call. `openai` with no OPENAI_API_KEY fails at
# startup rather than playing a sine tone where a voice should be.
TTS_PROVIDER="fake"
# Overrides the model pinned in openai-tts.provider.ts (verified 2026-09-12:
# gpt-4o-mini-tts). Re-verify the identifier, its voices and its pricing against
# current documentation before changing it.
OPENAI_TTS_MODEL=""
# FR-AUDIO-03: the voice used when a course has configured none. A course's own
# voice_identifier overrides it; see PATCH /admin/courses/:courseId/voice.
TTS_DEFAULT_VOICE=""
